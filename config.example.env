# Alan - offline AI voice assistant configuration
#
# Copy this file to config.env (install.sh does this for you) and edit config.env.
# Format rules, so that bash, docker compose and Python can all read it:
#   KEY=VALUE, one per line, no spaces around "=", no "export",
#   no comments after values, values containing spaces in double quotes.

# ---- Audio ----
# ALSA capture device. "auto" picks the first USB card from `arecord -l` (fallback hw:2,0).
AUDIO_INPUT=auto
# Length of each recording in seconds.
RECORD_SECONDS=5
# arecord sample rate in Hz (mono, S16_LE).
SAMPLE_RATE=44100
# Playback command: auto (pw-play if available, else aplay), pw-play or aplay.
AUDIO_PLAYER=auto

# ---- Speech-to-text (faster-whisper server in Docker) ----
WHISPER_URL=http://localhost:8000/v1/audio/transcriptions
WHISPER_MODEL=tiny.en
# Docker image used by docker-compose.yml for the whisper service.
WHISPER_IMAGE=fedirz/faster-whisper-server:latest-cpu

# ---- LLM (native Ollama) ----
# Base URL; the app appends /api/generate.
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:0.5b
SYSTEM_PROMPT="You are Alan, a helpful, concise AI assistant. Keep answers under 2 sentences."

# ---- Text-to-speech (Piper in the repo venv) ----
# Voice basename; files live at models/<PIPER_VOICE>.onnx and models/<PIPER_VOICE>.onnx.json.
PIPER_VOICE=en_GB-alan-medium

# ---- Display (pygame on the 3.5" SPI LCD) ----
SCREEN_WIDTH=480
SCREEN_HEIGHT=320
# Framebuffer device for the LCD.
SDL_FBDEV=/dev/fb0
# Optional SDL video driver, e.g. kmsdrm or fbcon. Leave empty to let SDL choose.
SDL_VIDEODRIVER=
# UI frame rate.
FPS=30
# 1 = draw the CPU temperature readout in the top-right corner, 0 = hide it.
SHOW_CPU_TEMP=1

# ---- Logging ----
# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
