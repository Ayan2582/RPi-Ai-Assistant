# systemd unit template for Alan.
# Installed by `scripts/install.sh --service`, which replaces __USER__, __REPO_DIR__
# and __UID__ and writes the result to /etc/systemd/system/alan.service.

[Unit]
Description=Alan - offline AI voice assistant
After=network-online.target docker.service ollama.service sound.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=PYTHONUNBUFFERED=1
ExecStart=__REPO_DIR__/scripts/start.sh
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
